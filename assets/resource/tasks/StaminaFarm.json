            "label": "$task_stamina_farm_budget",
            "inputs": [
                {
                    "name": "budget",
                    "label": "$task_stamina_farm_budget",
                    "default": "40",
                    "verify": "^(40|80|120|160|200|240)$",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "StaminaFarmEntrance": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "budget": "{budget}"
                            }
                        }
                    }
                }
            }
        },
