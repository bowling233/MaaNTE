{
    "task": [
        {
            "name": "StaminaFarm",
            "label": "$task_stamina_farm_label",
            "entry": "StaminaFarmEntrance",
            "description": "$task_stamina_farm_desc",
            "controller": [
                "Win32-Front"
            ],
            "group": [
                "Daily"
            ],
            "option": [
                "StaminaFarmStage",
                "StaminaFarmBudget",
                "StaminaFarmDifficulty",
                "StaminaFarmFighter"
            ]
        }
    ],
    "option": {
        "StaminaFarmStage": {
            "type": "select",
            "label": "$task_stamina_farm_stage",
            "default_case": "character_exp",
            "cases": [
                {
                    "name": "character_exp",
                    "label": "$task_stamina_farm_character_exp",
                    "pipeline_override": {
                        "StaminaFarmEntrance": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "stage": "character_exp"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "weapon_exp",
                    "label": "$task_stamina_farm_weapon_exp",
                    "pipeline_override": {
                        "StaminaFarmEntrance": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "stage": "weapon_exp"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "currency",
